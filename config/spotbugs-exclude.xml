<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions (KAN-168), mirrored from the service standard (e.g. ilr-eligibility-service).
  We keep the Medium threshold so FindSecBugs security detectors fire, but exclude the "expose
  internal representation" family: on Java records (transparent data carriers), Lombok-generated
  accessors, and Spring-injected beans (e.g. TenantContext) these fire constantly and flag
  by-design code, not real mutability defects. Excluding them keeps the gate high-signal.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      KAN-168: this is the FIRST time SpotBugs/FindSecBugs has ever run against ilr-common, so
      turning the gate on surfaced 4 pre-existing findings in code already on `main`. Each is
      reviewed below and scoped narrowly (class + specific bug pattern only, never a blanket
      exclude) rather than editing the security/tenancy source as part of a CI-infrastructure
      change — that edit belongs to whoever owns IlrSecurityAutoConfiguration/
      TenantSessionInitializer next, not to this ticket.
    -->

    <!-- False positive: `decoder` comes from `jwtDecoderProvider.getIfAvailable(() ->
         buildDecoder(properties))`, and `buildDecoder` can itself return null (no issuer/jwks
         configured). SpotBugs infers non-null from ObjectProvider's bytecode signature and
         misses that the fallback supplier can still produce null; the null check gates the
         intentional dev-permit-all fallback branch immediately below it and is not dead code. -->
    <Match>
        <Class name="com.cognivio.ai.common.security.IlrSecurityAutoConfiguration"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- Accepted, not a false positive: TenantSessionInitializer's constructors validate the
         `settingName` and fail fast with IllegalArgumentException, which is the correct
         behaviour for this fail-closed RLS primitive. CT_CONSTRUCTOR_THROW's actual risk
         (a partially-constructed object surviving via a malicious finalizer) requires the class
         to be non-final and have (or inherit) a finalizer; TenantSessionInitializer has neither,
         is never subclassed, and Java 21 has no default Object.finalize() risk left to exploit.
         A trivial hardening fix (marking the class `final`) would silence this outright, but
         that is a one-line application-code change outside a CI-infrastructure ticket's scope —
         flagged in KAN-168's PR for a fast-follow. -->
    <Match>
        <Class name="com.cognivio.ai.common.tenancy.TenantSessionInitializer"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- False positive: FindSecBugs flags the string concatenation used to BUILD the SQL text
         (`"SELECT set_config('" + settingName + "', ?, true)"`), but settingName is validated
         against SAFE_SETTING (`^[a-zA-Z_][a-zA-Z0-9_.]*$`) in the constructor before that
         concatenation ever happens and is always a compile-time/config-supplied constant
         (never client input — see the class javadoc). The one value that actually varies per
         call, the tenant UUID, is bound as a real PreparedStatement parameter (`?`), which is
         exactly the injection-safe pattern this detector otherwise exists to enforce. -->
    <Match>
        <Class name="com.cognivio.ai.common.tenancy.TenantSessionInitializer"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!-- False positive, and not one of the 4 original KAN-168 findings — RolePermissions (KAN-206)
         merged after this exclude file was written. MS_EXPOSE_REP flags policy() returning the
         static POLICY field because its declared type, Map<IlrRole, Set<IlrPermission>>, is
         mutable-shaped; SpotBugs does not reason about the actual runtime value. POLICY is built
         via `Map.copyOf(policy)` over per-role `Set.of(...)` values in buildPolicy(), both of which
         are genuinely unmodifiable — a caller of policy() cannot mutate the platform's authorization
         policy through the returned reference. The EI_EXPOSE_REP/REP2 exclusion above does not cover
         this because MS_EXPOSE_REP is the static-field variant of the same family. -->
    <Match>
        <Class name="com.cognivio.ai.common.authz.RolePermissions"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
