<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      spring-boot-starter-parent is used ONLY for dependency management + the
      standard plugin versions, exactly like the services. This module is a
      LIBRARY: packaging is `jar` and the spring-boot-maven-plugin repackage
      goal is NEVER applied, so `mvn install` produces a plain library jar (not
      an executable fat jar).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.cognivio.ai</groupId>
    <artifactId>ilr-common</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>ilr-common</name>
    <description>
        Shared cross-cutting library for the ILR Application Agent platform:
        Cognito JWT verification (OAuth2 resource server), verified-claim
        tenant/caller context, Postgres RLS session binding, and the common web
        DTOs + exception handler. Consumed by every ILR microservice as
        com.cognivio.ai:ilr-common:0.1.0-SNAPSHOT.
    </description>

    <properties>
        <java.version>21</java.version>
        <groovy.version>4.0.22</groovy.version>
        <spock.version>2.4-groovy-4.0</spock.version>
        <archunit.version>1.3.0</archunit.version>

        <!--
          Quality gate (KAN-168), versions pinned to match the service standard exactly
          (e.g. ilr-eligibility-service). jacoco's <excludes> below drop *AutoConfiguration
          (pure @Bean wiring) and *Properties (@ConfigurationProperties data holders) from the
          denominator, mirroring the services' **/config/** / *Config.class / *Properties.class
          exclusion — that IS this module's equivalent of "untestable Spring wiring".

          coverage.line.min was set by running `mvn verify` against what's on main with those
          exclusions applied and reading the actual measured ratio (80.6% line coverage at the
          time of KAN-168), not guessed up front: this module turned out to have no
          controller/service/repository layer inflating the numerator the way a service's does,
          but the classes that remain after excluding wiring (JWT conversion, tenant context,
          RLS session binding, the exception handler) are exactly the security/tenancy-critical
          code this library exists for, and they were already well covered. 0.75 is a deliberate
          ~5-point floor below the measured 80.6%, not the service's flat 0.80: with only 16
          classes in the bundle, a single medium class going untested for one PR moves the ratio
          by several points, and pinning the floor 0.6pp under actual (i.e. to 0.80) would make
          the gate flap on unrelated changes rather than catch real regressions.
        -->
        <jacoco.version>0.8.12</jacoco.version>
        <coverage.line.min>0.75</coverage.line.min>
        <spotbugs.plugin.version>4.8.6.4</spotbugs.plugin.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <pmd.plugin.version>3.26.0</pmd.plugin.version>
    </properties>

    <dependencies>
        <!--
          All Spring dependencies are `provided`: every consuming service already
          brings them at runtime via its own starters (web, security, data-jpa,
          validation). Keeping them provided means this library jar stays lean and
          never dictates the runtime versions of the consuming app. `provided`
          scope is still present on the compile AND test classpaths, so the library
          compiles and its own unit tests run.
        -->

        <!-- Auto-configuration infrastructure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J API (logging facade; consumers supply the binding via spring-boot-starter-logging) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Web (RestControllerAdvice, HandlerExceptionResolver, servlet filter) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Security: OAuth2 resource server (JWT verification) + JOSE (Nimbus) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Transaction + JDBC + AOP (RLS set_config binding) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson (serializing ErrorResponse from the auth entry point) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Bean Validation (ConstraintViolationException handling) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- CRaC API for AWS Lambda SnapStart (KAN-59). Compile scope — unlike the other Spring deps
             this is a genuinely new runtime dependency the consuming services don't otherwise carry,
             so it must be transitive. Tiny facade jar; a no-op on an ordinary (non-CRaC) JVM. -->
        <dependency>
            <groupId>org.crac</groupId>
            <artifactId>crac</artifactId>
        </dependency>

        <!-- HikariCP: compile-time reference for the SnapStart datasource checkpoint hook. Provided —
             every JPA service already supplies it at runtime via spring-boot-starter-data-jpa. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok (compile-only convenience; not transitive to consumers) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Generates IDE metadata for the ilr.security / ilr.rls properties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================ TEST ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spock (Groovy BDD) — matches the services' testing convention -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-core</artifactId>
            <version>${spock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-spring</artifactId>
            <version>${spock.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          ArchUnit backs the shared "every mapped controller method must declare an
          authorization decision" fitness function (KAN-206). It is `test` scope here and
          therefore NOT transitive: a consuming service that uses the shared rule from the
          test-jar must declare its own test-scoped archunit dependency. That is intentional
          — a library must not push a test framework onto every consumer's runtime.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          KAN-189: proves FORCE ROW LEVEL SECURITY + a non-owner runtime role actually defend
          against a cross-tenant read when the application layer never binds a tenant (the exact
          failure mode RlsTenantBindingAspect's javadoc calls out as previously untested). Real
          PostgreSQL only, via Testcontainers — RLS/owner-bypass semantics cannot be exercised
          against a mocked Connection or an in-memory database. Versions come from
          spring-boot-starter-parent's dependency management.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          KAN-222: ilr-common has no application of its own, so the harness is proved against a
          minimal @SpringBootApplication living in src/test
          (com.cognivio.ai.common.testsupport.selftest). That app needs web + JPA + Flyway +
          actuator at TEST scope only — this library must never push a web/JPA runtime onto a
          consumer. Consuming services already carry all four at compile scope via their own
          starters, so nothing here is expected of them.

          These are also what make the harness's central claim testable at all: `ddl-auto: validate`
          against a real Flyway-migrated schema, and /actuator/health reaching the real permit-list.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flyway 10 (Boot 3.3) needs the per-database module on the classpath explicitly. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          NOTE: no spring-boot-maven-plugin here. A library must remain a plain
          jar; applying the repackage goal would turn it into an executable fat
          jar that cannot be used as a normal dependency.
        -->
        <plugins>
            <!-- Compiles Groovy (Spock) specs living under src/test/groovy -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>3.0.2</version>
                <executions>
                    <execution>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <testSources>
                        <testSource>
                            <directory>${project.basedir}/src/test/groovy</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </testSource>
                    </testSources>
                </configuration>
            </plugin>

            <!--
              Publishes src/test/groovy's compiled output as a `tests`-classifier jar so the 16
              consuming services can reuse two shared test artifacts rather than reinventing them
              15 times (KAN-206):

                * ControllerAuthorizationRules — the ArchUnit fitness function that fails a build
                  when a mapped controller method declares no authorization decision.
                * IlrMethodSecurityTestSupport — a MockMvc harness that actually applies
                  @PreAuthorize. The estate's existing MockMvcBuilders.standaloneSetup(...) specs
                  build no Spring context and create no proxy, so method security is never applied
                  in them at all: without this harness a "403 for the wrong role" spec would pass
                  whether or not the annotation is there.

                * com.cognivio.ai.common.testsupport.integration.* — the Spring-context integration
                  test harness (KAN-222): singleton Testcontainers Postgres, the ilr_owner/ilr_app
                  role split the V3 migrations expect, and a base spec that boots a REAL Spring
                  context with security and RLS forced on.

              Consumers add:  <classifier>tests</classifier> <scope>test</scope>
              plus their own test-scoped archunit dependency (see the dependency comment above).

              The `excludes` below keep ilr-common's OWN proof harness out of the published jar.
              The selftest package contains a @SpringBootApplication, an @Entity and a
              @RestController; db/harness/migration contains Flyway scripts. Shipping either would
              be actively harmful to a consumer — a stray @SpringBootConfiguration on the test
              classpath breaks @SpringBootTest's configuration search, and stray migrations on the
              classpath can be picked up by the consumer's Flyway locations.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/cognivio/ai/common/testsupport/selftest/**</exclude>
                                <exclude>db/harness/**</exclude>
                                <!-- KAN-226: a class that deliberately calls requestMatchers(String...)
                                     so the ArchUnit rule forbidding it can be proved to fire. Useful
                                     only inside this module; shipping it would put the very call site
                                     the estate forbids onto every consumer's test classpath. -->
                                <exclude>com/cognivio/ai/common/security/violationfixture/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Spec.java</include>
                        <include>**/*Spec.class</include>
                        <include>**/*Test.java</include>
                    </includes>
                    <useFile>false</useFile>
                </configuration>
            </plugin>

            <!--
              KAN-222: integration tests are `*IT`, run by failsafe at integration-test/verify —
              deliberately NOT `*Spec` under surefire (which the includes above scope to unit tests
              only, so the split needs no exclude here).

              Three reasons, per the KAN-190 design:
                1. `mvn test` stays Docker-free. A developer without a Docker daemon keeps a green
                   `mvn test`; only `mvn verify` needs one.
                2. CI gets a distinct signal for "integration broke" vs "unit broke".
                3. Every ci.yml across the estate already runs `mvn -B -ntp verify`, so binding here
                   means the KAN-190 rollout needs ZERO edits to 26 copied workflow files.

              No <executions> block is needed: spring-boot-starter-parent's pluginManagement already
              binds failsafe's integration-test and verify goals. Declaring our own execution created
              a SECOND, duplicate one, which failsafe skipped with the misleading message
              "Skipping execution of surefire because it has already been run for this configuration".
              Only the `includes` differ from the parent's defaults, because Groovy-compiled specs
              produce .class files with no matching .java source.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IT.class</include>
                    </includes>
                    <useFile>false</useFile>
                </configuration>
            </plugin>

            <!-- Coverage (KAN-168): the agent instruments the Spock run; `report` writes the HTML/XML;
                 `check` fails the build if line coverage drops below ${coverage.line.min}. Matches the
                 service standard's mechanics (see ilr-eligibility-service/pom.xml); see the property
                 comment above for why the floor differs from the services' 0.80. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Exclude untestable Spring wiring from coverage, same rationale as the service
                         standard's **/config/** / *Config.class exclusion: this module has no main
                         class or @Configuration-suffixed classes, but it has the equivalent —
                         *AutoConfiguration classes (pure @Bean wiring) and *Properties records
                         (@ConfigurationProperties data holders with no logic). -->
                    <excludes>
                        <exclude>**/*AutoConfiguration.class</exclude>
                        <exclude>**/*Properties.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bug + security analysis (KAN-168): SpotBugs over the compiled bytecode, with the
                 FindSecBugs plugin for security detectors. Fails the build on medium+ findings.
                 Same configuration as the service standard — this module owns JWT verification and
                 RLS tenant binding, so it is held to the same bar, not a lower one. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Static rules (KAN-168): the same curated, low-noise PMD ruleset as the service
                 standard (config/pmd-ruleset.xml, copied verbatim). Fails the build on violations. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.plugin.version}</version>
                <configuration>
                    <targetJdk>${java.version}</targetJdk>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${project.basedir}/config/pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <testSourceDirectory>src/test/groovy</testSourceDirectory>
    </build>
</project>
